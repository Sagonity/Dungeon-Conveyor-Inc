# Shared formatting for VS Code, Rider and Visual Studio.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# Braces on their own line (Allman), like the existing code.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Use "var" only when the type is obvious.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# usings: System first, outside the namespace.
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion

[*.{json,asmdef,asmref,inputactions}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Unity YAML assets are written by the editor; don't reformat them.
[*.{unity,prefab,asset,mat,anim,controller,meta}]
insert_final_newline = unset
trim_trailing_whitespace = unset
