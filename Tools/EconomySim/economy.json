  "expeditions": {
    "_comment": "Loot x clamp(power / recommended, minLootShare, 1). A weak squad still gets something.",
    "minLootShare": 0.25
  },

  "bossCombat": {
    "_comment": "Economy stand-in for auto-combat (SCRUM-7): win chance rises linearly from 0 at loseBelow to 1 at winAbove (power / recommended).",
    "loseBelow": 0.85, "winAbove": 1.00
  },

  "playtest": {
    "_comment": "Step A playtest build (SCRUM-8): every timer runs this many times faster.",
    "timeScale": 10, "sessionMinutes": 45
  },

  "guardianTickets": { "max": 3, "regenHours": 4 },

  "equipment": {
    "_comment": "Weapon adds ATK, Armor adds HP, Tool adds mining power. Upgrade cost: Gold + the rare material of the tier the gear comes from.",
    "slots": { "Adventure": ["weapon", "armor"], "Miner": ["tool"] },
    "byRarity": {
      "Common": { "maxLevel": 10, "tier": 1, "weapon": [4, 1.0],  "armor": [40, 10],  "tool": [3, 0.6] },
      "Rare":   { "maxLevel": 15, "tier": 2, "weapon": [8, 1.6],  "armor": [80, 16],  "tool": [6, 1.0] },
      "Epic":   { "maxLevel": 20, "tier": 3, "weapon": [14, 2.5], "armor": [140, 25], "tool": [10, 1.6] }
