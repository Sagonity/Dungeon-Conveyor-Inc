      "tier": 3, "zone": "Crystal Depths", "mineral": "Mithril", "rareMaterial": "PrismDust",
      "expedition": { "name": "Crystal Depths", "minutes": 30, "recommendedPower": 520,
                      "loot": { "SummonShards": 14, "PrismDust": 3, "EmberCore": 2, "Gold": 300 }, "gearChance": 0.20, "gearRarity": "Epic" },
      "boss": { "name": "Prism Wyrm", "recommendedPower": 800,
                "firstClear": { "SummonShards": 100, "GuardianTickets": 1, "gear": "weapon_e" } }
    }
