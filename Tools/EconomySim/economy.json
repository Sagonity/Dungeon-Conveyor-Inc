  },

  "minions": [
    { "id": "miner_c",   "name": "Pebble Grub",     "kind": "Miner",     "role": null,      "rarity": "Common" },
    { "id": "fighter_c", "name": "Spore Bruiser",   "kind": "Adventure", "role": "Fighter", "rarity": "Common" },
    { "id": "tank_c",    "name": "Cart Shield",     "kind": "Adventure", "role": "Tank",    "rarity": "Common" },
    { "id": "miner_r",   "name": "Drill Sergeant",  "kind": "Miner",     "role": null,      "rarity": "Rare" },
    { "id": "support_r", "name": "Lamp Chaplain",   "kind": "Adventure", "role": "Support", "rarity": "Rare" },
