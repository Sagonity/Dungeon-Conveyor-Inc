  },

  "adventureBase": {
    "_comment": "Common, level 1, before role multipliers. Each level adds growthPerLevel x the level-1 value.",
    "hp": 100, "atk": 10, "growthPerLevel": 0.15
  },
  "roles": {
    "Fighter": { "hp": 0.8, "atk": 1.4 },
    "Tank":    { "hp": 1.6, "atk": 0.6 },
    "Support": { "hp": 1.0, "atk": 0.8 }
  },
  "minerBase": { "miningPower": 10, "growthPerLevel": 0.15 },

  "levels": {
    "capAtZeroStars": 20,
    "capPerStar": 5,
    "maxStars": 5,
